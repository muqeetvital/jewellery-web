rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper: Check if user is an explicit admin in users collection
    function isAdmin() {
      return request.auth != null && 
             exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true;
    }

    // Products collection permissions
    match /products/{productId} {
      // Anyone (customers and public visitors) can read listed products
      allow read: if true;
      // Only authenticated users with the isAdmin property in users collection can edit database
      allow write: if isAdmin();
    }

    // Users collection permissions (Users can read their own user profile document)
    match /users/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if false; // Only manageable manually via Firebase Console
    }

    // Settings collection permissions (Public can read, only admin can write)
    match /settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
