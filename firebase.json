{
  "firestore": {
    "rules": "firestore.rules"
  },
  "storage": {
    "rules": "storage.rules"
  },
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**",
      "seed-database.py",
      "run-seeder.bat",
      "firestore.rules",
      "storage.rules",
      "users_reset.json",
      "users_backup.json",
      "*.bat",
      "*.py"
    ],
    "rewrites": [
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  }
}
